{
  "name": "clutch-arena-td",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist-crazygames",
    "build:poki": "tsc --noEmit && vite build --mode poki --outDir dist-poki",
    "release": "npm run build:crazygames && npm run build:poki && node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.175.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.3",
    "vite": "^6.4.6"
  }
}
